# Dockerfile.analysis — OEL-based opencode analysis container
#
# ─── BUILDING ────────────────────────────────────────────────────────────────
#
#   # OEL 9 (works on any x86-64 CPU, recommended for older hardware)
#   docker build -t opencode-analysis:oel9 -f Dockerfile.analysis .
#
#   # OEL 10 (requires AVX2 / x86-64-v3; AMD FX / pre-Haswell Intel will fail)
#   docker build -t opencode-analysis:oel10 -f Dockerfile.analysis \
#     --build-arg OEL_VERSION=10 .
#
#   # Specific fork branch
#   docker build -t opencode-analysis:dev -f Dockerfile.analysis \
#     --build-arg REPO_BRANCH=dev .
#
# ─── RUNNING ─────────────────────────────────────────────────────────────────
#
#   # Minimal — baked-in safe defaults, no LLM configured (good for testing)
#   docker run --rm -it \
#     --user $(id -u):$(id -g) \
#     -v /path/to/project:/workspace \
#     opencode-analysis:oel9
#
#   # With cloud API key
#   docker run --rm -it \
#     --user $(id -u):$(id -g) \
#     -v /path/to/project:/workspace \
#     -e ANTHROPIC_API_KEY \
#     opencode-analysis:oel9
#
#   # With private config injected at runtime (local LLMs, internal policy)
#   docker run --rm -it \
#     --user $(id -u):$(id -g) \
#     -v /path/to/project:/workspace \
#     -v /path/to/private/config-dir:/run/opencode-config:ro \
#     -e OPENCODE_CONFIG_DIR=/run/opencode-config \
#     opencode-analysis:oel9
#
#   # Or use the companion opencode-run.sh script (builds if needed, wraps above)
#   ./opencode-run.sh [--oel 9|10] [--config /path/to/config-dir] /path/to/project
#
# ─── EXEC / ADMIN ────────────────────────────────────────────────────────────
#
#   # Install system packages (microdnf) while container is running:
#   docker exec -u root -it <container_name> bash
#
#   # Install Perl modules (no root needed — cpanm uses ~/perl5 via local::lib):
#   docker exec -it <container_name> bash
#   cpanm Some::Module
#
#   # The LLM (opencode) runs without root — it cannot install system packages.
#   # This is intentional. The AI can freely use cpanm for Perl modules.
#
#   # Drop --rm when you need exec access after opencode exits:
#   docker run -it --user $(id -u):$(id -g) -v .:/workspace opencode-analysis:oel9
#   docker exec -u root -it mystifying_whatever bash
#
# ─── CONFIG PRECEDENCE (low → high) ──────────────────────────────────────────
#
#   ~/.config/opencode/   baked into image — safe defaults, audit on, no LLM
#   /workspace/.opencode/ project config, auto-discovered from bind-mount
#   ~/.opencode/          user-global (not baked in; mount if needed)
#   $OPENCODE_CONFIG_DIR  runtime injection — LLM endpoints, policy overrides
#
#   Project-level .opencode/ overrides the baked-in defaults.
#   OPENCODE_CONFIG_DIR overrides everything — use it for LLM endpoints and
#   environment-specific policy. Keep that config in the private infra repo.
#

ARG OEL_VERSION=9

# ─── BUILD STAGE ─────────────────────────────────────────────────────────────
FROM oraclelinux:${OEL_VERSION}-slim AS build

ARG OEL_VERSION=9
RUN microdnf install -y --nodocs \
      git-core curl unzip xz \
    && microdnf clean all

# Install Bun
ARG BUN_VERSION=1.3.9
ENV BUN_INSTALL=/opt/bun
ENV PATH=/opt/bun/bin:$PATH
RUN curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"

# Clone and build
ARG REPO_URL=https://github.com/donwulff/opencode.git
ARG REPO_BRANCH=dev
WORKDIR /build
RUN git clone --depth 1 --branch "${REPO_BRANCH}" "${REPO_URL}" . \
    && bun install \
    && cd packages/opencode \
    && bun run script/build.ts --single

# ─── RUNTIME STAGE ───────────────────────────────────────────────────────────
ARG OEL_VERSION=9
FROM oraclelinux:${OEL_VERSION}-slim

ARG OEL_VERSION=9
RUN microdnf install -y --nodocs \
      oracle-epel-release-el${OEL_VERSION} \
    && microdnf install -y --nodocs \
      git-core ripgrep curl jq \
      perl perl-libs perl-utils perl-App-cpanminus \
      perl-JSON perl-File-Find \
      nodejs \
    && microdnf clean all

# Copy the built binary
COPY --from=build /build/packages/opencode/dist/opencode-linux-x64/bin/opencode /usr/local/bin/opencode

# Create coder user and pre-create all XDG directories opencode needs at startup.
# opencode resolves paths via xdg-basedir (HOME-relative):
#   ~/.local/share/opencode/{log,bin}  — database, logs, binaries
#   ~/.local/state/opencode/           — state
#   ~/.cache/opencode/                 — cache
#   ~/.config/opencode/                — config (baked-in defaults below)
#
# Pre-creating them here (as root) and chmod -R 777 lets any --user UID write
# at runtime without hitting root-owned 755 intermediate directories blocking
# subdirectory creation (e.g. root-owned ~/.local/ preventing mkdir ~/.local/share/).
#
# Perl local::lib: cpanm installs modules to ~/perl5 without root.
# The LLM can use cpanm freely; it cannot touch system packages (no sudo).
# For system package installs during development, exec in as root:
#   docker exec -u root -it <container> bash
#   microdnf install perl-Some-Module
# Note: drop --rm from docker run if you need to exec after opencode exits.
RUN useradd -u 1000 -m coder \
    && mkdir -p \
        /home/coder/.local/share/opencode/log \
        /home/coder/.local/share/opencode/bin \
        /home/coder/.local/state/opencode \
        /home/coder/.cache/opencode \
        /home/coder/.config/opencode \
        /home/coder/perl5 \
    && chmod -R 777 /home/coder
ENV HOME=/home/coder
# Perl local::lib — modules installed via cpanm land in ~/perl5, no root needed
ENV PERL_LOCAL_LIB_ROOT=/home/coder/perl5
ENV PERL_MB_OPT="--install_base \"/home/coder/perl5\""
ENV PERL_MM_OPT="INSTALL_BASE=/home/coder/perl5"
ENV PERL5LIB=/home/coder/perl5/lib/perl5
ENV PATH=/home/coder/perl5/bin:$PATH

# Bake in safe defaults at the lowest config precedence level.
# These are overridden by any project .opencode/ or $OPENCODE_CONFIG_DIR.
# Do NOT put LLM endpoints or internal URLs here — those go in the runtime
# config injected via OPENCODE_CONFIG_DIR in the private infra repo.
RUN cat > /home/coder/.config/opencode/opencode.jsonc <<'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "security": {
    "audit_log_enabled": true,
    "models_dev_enabled": false
  },
  "provenance": {
    "enabled": true,
    "preview_chars": 240
  }
}
EOF

WORKDIR /workspace

RUN opencode --version
ENTRYPOINT ["opencode"]
